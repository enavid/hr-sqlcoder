# ── Ollama ────────────────────────────────────────────────
OLLAMA_URL=http://YOUR_SERVER_IP:11434/api/generate
OLLAMA_TAGS_URL=http://YOUR_SERVER_IP:11434/api/tags
MODEL_NAME=llama3-sqlcoder

# ── Schema ────────────────────────────────────────────────
SCHEMA_PATH=./schema_context.txt

# ── PostgreSQL ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password

# ── Model defaults ────────────────────────────────────────
MODEL_TEMPERATURE=0.4
MODEL_TOP_P=0.5
